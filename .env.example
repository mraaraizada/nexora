# Telegram Bot API — create a bot via @BotFather in Telegram, add it as admin to your channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public @username of the channel (no leading @), used only to build a public t.me permalink.
# Leave blank if the chat/channel has no public username (e.g. a private group).
TELEGRAM_CHANNEL_USERNAME=

# Mastodon — Settings > Development > New Application on your instance (e.g. mastodon.social)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Discord — Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=
# Optional: used only to build a full https://discord.com/channels/... permalink
DISCORD_GUILD_ID=

# Dev.to — https://dev.to/settings/extensions, "DEV API Keys"
DEVTO_API_KEY=

# Bluesky (AT Protocol) — use an app password, not your real account password:
# https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
