# Telegra.ph — no account/credentials required at all; a fresh author identity is
# created automatically on every publish if this is left blank.
# Optional: set this only to reuse one persistent author identity across posts.
TELEGRAPH_ACCESS_TOKEN=

# Mastodon — Settings > Development > New Application on your instance (e.g. mastodon.social)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Write.as — no credentials required at all; anonymous posting works out of the box.
# Optional: set this only if you want the post attributed to a real account instead
# of posting anonymously. Get one at https://write.as/api/
WRITEAS_ACCESS_TOKEN=

# Dev.to — https://dev.to/settings/extensions, "DEV API Keys"
DEVTO_API_KEY=

# Bluesky (AT Protocol) — use an app password, not your real account password:
# https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
